import java.util.*;
import java.util.stream.IntStream;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int[] a = new int[3];
        int[] b = new int[3];

       
        for (int i = 0; i < 3; i++) {
            a[i] = sc.nextInt();
        }

     
        for (int i = 0; i < 3; i++) {
            b[i] = sc.nextInt();
        }

      
        long alice = IntStream.range(0, 3)
                .filter(i -> a[i] > b[i])
                .count();

  
        long bob = IntStream.range(0, 3)
                .filter(i -> a[i] < b[i])
                .count();

        System.out.println(alice + " " + bob);
    }
}



