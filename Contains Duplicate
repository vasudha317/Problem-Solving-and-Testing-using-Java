import java.util.*;
import java.util.stream.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] nums = new int[n];

        for (int i = 0; i < n; i++) {
            nums[i] = sc.nextInt();
        }

        boolean result = Arrays.stream(nums)
                .distinct()
                .count() != nums.length;

        System.out.println(result);
    }
}



Input
4
1 2 3 1

Output
true
